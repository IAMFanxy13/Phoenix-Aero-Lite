* text=auto
.gitattributes text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.cfg text eol=lf
*.j2 text eol=lf

# Captured upstream output is immutable evidence; progress lines can contain
# padding spaces emitted by the upstream program.
artifacts/upstream_validation/**/stdout.txt -whitespace
artifacts/upstream_validation/**/stderr.txt -whitespace
