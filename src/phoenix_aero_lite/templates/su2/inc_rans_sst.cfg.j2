% Phoenix Aero Lite deterministic SU2 configuration
% Target solver: SU2 v8.5.0 "Harrier"
% Structural sources: official SU2 v8.5.0 config_template.cfg and
% official SU2 v8.5.0 incompressible SST test case.
% Body frame: +x forward, +y starboard, +z up; angle of attack rotates
% freestream velocity in the x-z plane and sideslip is zero.

% ------------------------- Governing equations ------------------------- %
SOLVER= INC_RANS
KIND_TURB_MODEL= SST
SST_OPTIONS= ( SUSTAINING )
MATH_PROBLEM= DIRECT
RESTART_SOL= NO
TIME_MARCHING= NO

% ---------------------- Incompressible SI state ------------------------ %
INC_NONDIM= DIMENSIONAL
INC_DENSITY_MODEL= CONSTANT
INC_DENSITY_INIT= {{ density_kg_m3 | su2_number }}
INC_VELOCITY_INIT= ( {{ velocity_vector_m_s[0] | su2_number }}, {{ velocity_vector_m_s[1] | su2_number }}, {{ velocity_vector_m_s[2] | su2_number }} )
INC_ENERGY_EQUATION= NO
VISCOSITY_MODEL= CONSTANT_VISCOSITY
MU_CONSTANT= {{ dynamic_viscosity_pa_s | su2_number }}

% ------------------------ Reference geometry --------------------------- %
REF_AREA= {{ reference_area_m2 | su2_number }}
REF_LENGTH= {{ reference_length_m | su2_number }}
REF_ORIGIN_MOMENT_X= 0
REF_ORIGIN_MOMENT_Y= 0
REF_ORIGIN_MOMENT_Z= 0

% --------------------------- Boundary tags ----------------------------- %
MARKER_HEATFLUX= ( aircraft, 0.0 )
MARKER_FAR= ( farfield )
MARKER_PLOTTING= ( aircraft )
MARKER_MONITORING= ( aircraft )

% ------------------------ Spatial discretization ----------------------- %
NUM_METHOD_GRAD= WEIGHTED_LEAST_SQUARES
CONV_NUM_METHOD_FLOW= FDS
MUSCL_FLOW= YES
SLOPE_LIMITER_FLOW= VENKATAKRISHNAN
VENKAT_LIMITER_COEFF= 0.05
CONV_NUM_METHOD_TURB= SCALAR_UPWIND
MUSCL_TURB= NO

% ---------------- Temporal and linear-solver controls ------------------ %
TIME_DISCRE_FLOW= EULER_IMPLICIT
TIME_DISCRE_TURB= EULER_IMPLICIT
LINEAR_SOLVER= FGMRES
LINEAR_SOLVER_PREC= LU_SGS
LINEAR_SOLVER_ERROR= 1e-06
LINEAR_SOLVER_ITER= 10
CFL_NUMBER= 10
CFL_ADAPT= YES
CFL_ADAPT_PARAM= ( 0.5, 1.5, 1, 100 )
MAX_DELTA_TIME= 1e+06

% --------------------- Iteration and convergence ----------------------- %
ITER= {{ max_iterations }}
CONV_FIELD= RMS_PRESSURE
CONV_RESIDUAL_MINVAL= -8
CONV_STARTITER= 10
CONV_CAUCHY_ELEMS= 100
CONV_CAUCHY_EPS= 1e-06

% ------------------------- Case-local files ---------------------------- %
MESH_FILENAME= mesh.su2
MESH_FORMAT= SU2
CONV_FILENAME= history
RESTART_FILENAME= restart_flow.dat
SOLUTION_FILENAME= restart_flow.dat
VOLUME_FILENAME= flow
SURFACE_FILENAME= surface_flow
TABULAR_FORMAT= CSV
OUTPUT_FILES= ( RESTART, PARAVIEW, SURFACE_PARAVIEW )
OUTPUT_WRT_FREQ= {{ max_iterations }}
HISTORY_WRT_FREQ_INNER= 1

% ---------------------- Explicit auditable output ---------------------- %
SCREEN_WRT_FREQ_INNER= 1
SCREEN_OUTPUT= ( INNER_ITER, RMS_PRESSURE, RMS_TKE, RMS_DISSIPATION, LIFT, DRAG, FORCE_X, FORCE_Y, FORCE_Z )
HISTORY_OUTPUT= ( INNER_ITER, RMS_PRESSURE, RMS_TKE, RMS_DISSIPATION, LIFT, DRAG, FORCE_X, FORCE_Y, FORCE_Z )
